# Placeholders only. Copy to .env (gitignored) or export the variables in your shell.
# Only commands that read the source tables (build-dataset, train from a source, queue, monitor,
# check-contract, draft-contact-map, diagnose) use these. Everything else works on files.

# Which adapter to use: sqlite | sqlserver
CQR_BACKEND=sqlite

# One entry per product line, comma separated: <product_line>=<target>
# sqlite:    target is a file path.
# sqlserver: target is a database name on the server below.
CQR_SOURCES=auto=data/demo.db

# Optional path to a JSON settings file (see examples/settings.example.json).
CQR_CONFIG=

# --- SQL Server connection (used when CQR_BACKEND=sqlserver) ---
CQR_DB_DRIVER=ODBC Driver 18 for SQL Server
CQR_DB_HOST=localhost
CQR_DB_PORT=1433
# Leave CQR_DB_USER empty to use integrated authentication (Trusted_Connection).
CQR_DB_USER=report_reader
CQR_DB_PASSWORD=change-me
# Optional schema used to qualify table names (for example dbo).
CQR_DB_SCHEMA=
# yes only for local test servers with self-signed certificates.
CQR_DB_TRUST_SERVER_CERT=no
# Character encoding the driver should use for CHAR/VARCHAR columns (cp1252 for Latin-1 collations).
CQR_DB_CHAR_ENCODING=utf-8
CQR_DB_LOGIN_TIMEOUT=10
CQR_DB_QUERY_TIMEOUT=120
